# Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Database Settings (Local Docker PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aurora_admissions
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Amazon Aurora Serverless v2 PostgreSQL (Uncomment for AWS)
# DATABASE_HOST=aurora-admissions-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_NAME=aurora_admissions
# DATABASE_USER=admissions_admin
# DATABASE_PASSWORD=YourStrongPasswordHere!
# DATABASE_SSL=true

# Connection Pool Tuning
DB_POOL_MAX=25
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000

# CORS & Rate Limiting
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=5000