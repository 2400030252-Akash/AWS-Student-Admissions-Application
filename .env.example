# ==============================================================================
# Aurora Serverless v2 Admissions Project - Environment Configuration
# ==============================================================================

# Server Settings
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings (Default: Local Docker PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aurora_admissions
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# Amazon Aurora PostgreSQL Serverless v2 (Uncomment & configure for AWS)
# ------------------------------------------------------------------------------
# DATABASE_HOST=aurora-admissions-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_NAME=aurora_admissions
# DATABASE_USER=admissions_admin
# DATABASE_PASSWORD=YourStrongPasswordHere!
# DATABASE_SSL=true

# ------------------------------------------------------------------------------
# Database Connection Pool Tuning
# ------------------------------------------------------------------------------
DB_POOL_MAX=25
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000

# ------------------------------------------------------------------------------
# API Security & Rate Limiting
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=5000

# ------------------------------------------------------------------------------
# Frontend Environment Variable
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
